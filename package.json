{
  "name": "dsh-api-tools",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "^22.18.0 || >=24.11.0" },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./tool": { "types": "./lib/tool.d.ts", "default": "./lib/tool.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "dsh-better-sidebar"],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit --emitDeclarationOnly false",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc && tsc -p tsconfig.client.json && tsdown",
    "prepare": "npm run build"
  },
  "files": ["lib/**", "cordis.patch.yml", "README.md", "docs/**"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "dsh-better-sidebar": "^0.12.2",
    "react": "^18.2.0"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
